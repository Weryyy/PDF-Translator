{
  "model_name": "facebook/mbart-large-50-many-to-many-mmt",
  "batch_size": 8,
  "learning_rate": 2e-5,
  "num_epochs": 3,
  "max_length": 512,
  "warmup_steps": 500,
  "weight_decay": 0.01,
  "fp16": true,
  "gradient_accumulation_steps": 4,
  "dataloader_num_workers": 4,
  "save_strategy": "epoch",
  "evaluation_strategy": "epoch",
  "logging_steps": 100,
  "output_dir": "./models/translation_model"
}
